---
layout: default
---

<style>
  .cv ul.list-group.list-group-flush {
    list-style: none !important;
    padding-left: 0 !important;
    margin-left: 0 !important;
  }

  .cv ul.list-group.list-group-flush > li.list-group-item {
    list-style: none !important;
  }

  .cv ul.list-group.list-group-flush > li.list-group-item::marker {
    content: "" !important;
  }

  .cv ul.list-group.list-group-flush > li.list-group-item::before {
    content: none !important;
    display: none !important;
  }

  .cv .table-cv .badge {
  position: relative;
  top: 7px;
  }

  /* Remove the grey separators around date/location blocks */
    .cv .table-cv,
    .cv .table-cv tbody,
    .cv .table-cv tr,
    .cv .table-cv td {
      border: none !important;
      box-shadow: none !important;
    }

    /* Add a little space between the date and the location */
    .cv .table-cv tr + tr td {
      padding-top: 8px !important;
    }

    /* Keep location spacing controlled */
    .cv .table-cv .location {
      margin-top: 0 !important;
    }
</style>

{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}
{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
  </div>
{% endif %}